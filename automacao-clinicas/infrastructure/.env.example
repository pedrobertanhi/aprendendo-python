# Environment Variables - Sistema de Automação WhatsApp
# IMPORTANTE: Altere TODOS os valores antes de usar em produção!

# ============================================
# POSTGRES DATABASE
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ALTERE_SENHA_POSTGRES_FORTE_AQUI
POSTGRES_DB=postgres

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=ALTERE_SENHA_REDIS_FORTE_AQUI

# ============================================
# EVOLUTION API
# ============================================
EVOLUTION_API_KEY=ALTERE_SUA_CHAVE_API_EVOLUTION_AQUI
EVOLUTION_SERVER_URL=https://api.seu-dominio.com.br

# ============================================
# N8N
# ============================================
N8N_HOST=n8n.seu-dominio.com.br
N8N_WEBHOOK_URL=https://n8n.seu-dominio.com.br
N8N_ENCRYPTION_KEY=ALTERE_CHAVE_ENCRIPTACAO_N8N_AQUI

# N8N Authentication
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ALTERE_SENHA_N8N_AQUI

# ============================================
# GERAÇÃO DE SENHAS FORTES
# ============================================
# Use os comandos abaixo para gerar senhas seguras:
#
# Linux/Mac:
#   openssl rand -base64 32
#   openssl rand -hex 32
#
# Python:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Online (use com cuidado):
#   https://passwordsgenerator.net/
#
# Recomendações:
# - Mínimo 32 caracteres
# - Mistura de letras, números e símbolos
# - Diferente para cada serviço
# - Armazenar em gerenciador de senhas
